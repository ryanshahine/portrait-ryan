{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portrait-ryan",
  "main": ".portrait/worker.js",
  "compatibility_date": "2026-08-12",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
